DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
<FilesMatch "^(Admin|Login)\.dc\.html$">
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/(it|en)/([^?\s]*) [NC]
RewriteRule ^public/(it|en)/(.*)$ /%1%2/%3 [R=301,L,NE]
RewriteRule ^(?:old-page|data|content|pages-src|partials|tools|files\ MD|PHP\ di\ sistema)(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^(?:Admin|Login)\.dc\.html$ %1admin/ [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^(?:ComproDiamanti(?:-standalone-src)?(?:\.dc)?)\.html$ %1it/index.html [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^Quotazione\.dc\.html$ %1it/valutazione.html [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^Grazie\.dc\.html$ %1it/grazie.html [R=302,L,NC]
</IfModule>
