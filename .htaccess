DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Pagine pubbliche (2.1.44): script e connessioni solo da HTTPS, così Google, Meta, Clarity e gli «Altri codici» possono caricarsi
# dopo il consenso; gli script in linea restano vietati. L'amministrazione ha la regola stretta in admin/.htaccess e api/.htaccess.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' https: data:; connect-src 'self' https:; frame-src https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
<FilesMatch "^(Admin|Login)\.dc\.html$">
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
# Un solo indirizzo per Google (2.1.48, audit): valutazionediamanti.it senza www e comprodiamanti.it vanno con un 301 su www.
# Vale per le pagine passate ad Apache; per i file serviti direttamente da nginx serve anche il «Dominio preferito» di Plesk.
# HTTPS sempre (2.1.71, checklist D6): un solo 301 verso https://www. anche da http://www.; Plesk passa ad Apache le richieste HTTPS con HTTPS=on.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} ^www\.valutazionediamanti\.it$ [NC]
RewriteRule ^(.*)$ https://www.valutazionediamanti.it/$1 [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^valutazionediamanti\.it$ [NC]
RewriteRule ^(.*)$ https://www.valutazionediamanti.it/$1 [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?comprodiamanti\.it$ [NC]
RewriteRule ^ https://www.valutazionediamanti.it/it/index.html [R=301,L]
# Radice del sito (2.1.63, audit): 301 verso la home italiana anche se il server prova index.html prima di index.php.
RewriteCond %{REQUEST_URI} ^(.*/)$
RewriteRule ^$ %1it/index.html [R=301,L]
# Blog inglese con lo schema del sito (2.1.63): /en/blog/ e /en/blog/<slug>; blog/index.php rimanda con un 301 i vecchi ?lang=en.
RewriteRule ^en/blog/?$ blog/index.php [L,QSA]
RewriteRule ^en/blog/[a-z0-9-]+/?$ blog/index.php [L,QSA]
# Pagine inglesi con indirizzi inglesi (2.1.52): 301 dai vecchi nomi italiani.
RewriteCond %{REQUEST_URI} ^(.*/)en/acquistiamo\.html$ [NC]
RewriteRule ^ %1en/sell-diamonds.html [R=301,L,QSA]
RewriteCond %{REQUEST_URI} ^(.*/)en/valutazione\.html$ [NC]
RewriteRule ^ %1en/free-valuation.html [R=301,L,QSA]
RewriteCond %{REQUEST_URI} ^(.*/)en/chisiamo\.html$ [NC]
RewriteRule ^ %1en/about-us.html [R=301,L,QSA]
RewriteCond %{REQUEST_URI} ^(.*/)en/privacy\.html$ [NC]
RewriteRule ^ %1en/privacy-policy.html [R=301,L,QSA]
RewriteCond %{REQUEST_URI} ^(.*/)en/cookie\.html$ [NC]
RewriteRule ^ %1en/cookie-policy.html [R=301,L,QSA]
RewriteCond %{REQUEST_URI} ^(.*/)en/grazie\.html$ [NC]
RewriteRule ^ %1en/thank-you.html [R=301,L,QSA]
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/(it|en)/([^?\s]*) [NC]
RewriteRule ^public/(it|en)/(.*)$ /%1%2/%3 [R=301,L,NE]
RewriteRule ^(?:old-page|data|content|pages-src|partials|tools|files\ MD|PHP\ di\ sistema)(?:/|$) - [F,L,NC]
# Collegamento Frase come WordPress (2.1.39): Frase pubblica solo su CMS noti, il sito risponde su /wp-json/ tramite blog/wp-bridge.php.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^(?:wp-json|wp-admin) - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^(?:wp-json(?:/.*)?|wp-admin(?:/.*)?|wp-login\.php|xmlrpc\.php)$ blog/wp-bridge.php [L,QSA]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^(?:Admin|Login)\.dc\.html$ %1admin/ [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^(?:ComproDiamanti(?:-standalone-src)?(?:\.dc)?)\.html$ %1it/index.html [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^Quotazione\.dc\.html$ %1it/valutazione.html [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*/)[^/]*$
RewriteRule ^Grazie\.dc\.html$ %1it/grazie.html [R=302,L,NC]
</IfModule>
